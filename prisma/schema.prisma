generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model FirstTimer {
  id                  String       @id @default(cuid())
  firstName           String
  lastName            String
  phone               String
  address             String?
  visitDate           String
  prayerRequest       String?
  status              String       @default("New")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  assignedToId        String?
  isHandedOver        Boolean      @default(false)
  discoverySource     String?
  dob                 String?
  email               String?
  isBornAgain         String?
  isHolyGhostBaptized String?
  occupation          String?
  preferredVisitTime  String?
  serviceComment      String?
  sex                 String?
  attendances         Attendance[]
  assignedTo          User?        @relation(fields: [assignedToId], references: [id])
  followUps           FollowUp[]
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  password      String
  role          Role         @default(MEMBER)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  attendances   Attendance[]
  assignedItems FirstTimer[]
  followUps     FollowUp[]
}

model FollowUp {
  id           String       @id @default(cuid())
  userId       String
  firstTimerId String
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  type         FollowUpType @default(NOTE)
  firstTimer   FirstTimer   @relation(fields: [firstTimerId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])
}

model Attendance {
  id           String     @id @default(cuid())
  date         DateTime
  firstTimerId String
  createdAt    DateTime   @default(now())
  userId       String?
  firstTimer   FirstTimer @relation(fields: [firstTimerId], references: [id], onDelete: Cascade)
  user         User?      @relation(fields: [userId], references: [id])
}

enum Role {
  ADMIN
  MEMBER
}

enum FollowUpType {
  CALL
  PRAYER
  NOTE
  VISIT
  TEXT
}
